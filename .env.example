# ════════════════════════════════════════════════════════════════
# StratRoom Environment Configuration
# Copy to .env and fill in values for production deployment.
# ════════════════════════════════════════════════════════════════

# ── Application ──
ENVIRONMENT=production
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON_MODE=true
ENABLE_DOCS=false

# ── Database ──
DATABASE_URL=postgresql+asyncpg://stratroom:CHANGE_ME@db:5432/stratroom
POSTGRES_USER=stratroom
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=stratroom
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true

# ── Authentication ──
JWT_SECRET=CHANGE_ME_TO_RANDOM_64_CHAR_HEX
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── CORS ──
CORS_ORIGINS=https://yourdomain.com

# ── Rate Limiting ──
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_AI_PER_MINUTE=30

# ── Docker Ports ──
DB_PORT=5432
API_PORT=8001
