# ════════════════════════════════════════════════════════════════
# StratRoom Environment Configuration
# Copy to .env and fill in values for production deployment.
# ════════════════════════════════════════════════════════════════

# ── Application ──
ENVIRONMENT=production
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON_MODE=true
ENABLE_DOCS=false

# ── Database ──
# MySQL-only since July 2026: all data access goes through the
# MySQL bridge (java_bridge.py). Set MYSQL_* credentials below.

# ── MySQL (via SSH tunnel to production) ──
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3307
MYSQL_USER=stratroom
MYSQL_PASSWORD=CHANGE_ME
MYSQL_DATABASE=orgstructure

# ── Authentication ──
JWT_SECRET=CHANGE_ME_TO_RANDOM_64_CHAR_HEX
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── CORS ──
CORS_ORIGINS=https://yourdomain.com

# ── Rate Limiting ──
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_AI_PER_MINUTE=30

# ── Docker Ports ──
API_PORT=8001
